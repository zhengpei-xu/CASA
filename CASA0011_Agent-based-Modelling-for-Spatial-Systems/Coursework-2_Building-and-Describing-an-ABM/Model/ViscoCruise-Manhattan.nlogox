<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[;;============================================================
;; VISCO-CRUISE MODEL
;; Agent-Based Model of Taxi and FHV Vacant Cruising Behaviour
;; Stylised Midtown Manhattan Grid
;; Author: Zhengpei Xu      Date: 14/4/2026
;;============================================================


breed [vehicles vehicle]
breed [passengers passenger]

globals [
  ;; --- Agentsets ---
  intersections 
  roads

  ;; --- Traffic Signals ---
  signal-posts
  
  row-signals 
  col-signals
  
  row-green? 
  col-green?
  
  ;; --- Traffic Lights Intervals ---
  ;; the time is not consistent with 
  ;; real world traffic lights length (30s for example)
  ;; to avoid the corner congestion arising from limiting space
  ; length-of-green-light      ; controlled by slider
  
  ;; --- Total vehicle number ---
  ; num-cars                   ; controlled by slider
  
  ;; --- Taxi & FHV & Background Traffic Split Controller ---
  ; commercial-vehicle-ratio   ; controlled by slider
  ; Taxi-vs-FHV-split          ; controlled by slider

  ;; --- Passenger Demand Rate ---
  ; max-passengers             ; controlled by slider
  
  ;; --- Performance Metrics ---
  taxi-dead-miles 
  FHV-dead-miles       
  
  taxi-trips 
  FHV-trips
  ;------------------------
  avg-taxi-dead-miles 
  avg-FHV-dead-miles
  
  avg-taxi-dead-per-trip 
  avg-FHV-dead-per-trip
  ;--------------------------
  global-average-speed
  
  baseline-speed-value
]

vehicles-own [
  vehicle-type         ; "background traffic", "taxi", or "for hire vehicle (FHV)"
  reaction-delay       ; Stochastic timer for gridlock/signal recovery
  has-passenger?       ; True if carrying a passenger
  target-patch         ; Passenger destination
  is-congested?        ; Blocked by another vehicle
  blocked-by-signal?   ; Blocked by red light
  did-move?            ; Flag for movement in current tick (for caculating Speed)
]

patches-own [
  is-road? 
  is-intersection? 
  
  is-signal-here? 
  is-green?
  
  ;; --- for constructing Manhattan One Way Road System ---
  can-go-north? 
  can-go-south? 
  can-go-east? 
  can-go-west?
  
  ;; --- for generting passengers and cruising visco ---
  demand-intensity     ; Heatmap: 1.0 (High), 0.5 (Mid), 0.2 (Low)
]

passengers-own [ destination-patch ]

;;;;;;;;;;;;;;;;;;;;;;;;
;;; 1. SETUP PROCEDURES
;;;;;;;;;;;;;;;;;;;;;;;;

to setup
  clear-all
  setup-environment
  setup-manhattan-basemap
  setup-signals 
  setup-demand-zones 
  setup-population 
  reset-ticks
end

to setup-environment
  ;; --- initializing traffic lights status ---
  set row-green? true 
  set col-green? false
  
  ;; --- initializing taxi and FHV deadmile ---
  set taxi-dead-miles 0 
  set FHV-dead-miles 0
end

to setup-manhattan-basemap
  ;; --- define grid structure ---
  resize-world -60 60 -42 35 ; (0,0) representing TIMES SQUARE

  ask patches [
    set pcolor [207 207 207]
    set is-road? false 
    set is-intersection? false
    set is-signal-here? false
  ]
  
  ;; --- setup Manhattan Road structure (based on real world)---
  ;; from 10th to Park AVE
  ;; to simplify the road system
  ;; the Broadway (which is non-orthogonal) is not covered 
  let ave-x-ranges [
    [-60 -59]          ; 10th Avenue
    [-40 -39]          ; 9th Avenue
    [-20 -19]          ; 8th Avenue
    [0 1]              ; 7th Avenue
    [20 21]            ; 6th Avenue
    [40 41]            ; 5th Avenue
    [49 50]            ; Madison Avenue
    [59 60]            ; Park Avenue
  ]
  
  ; from 50th to 39th Streets
  let street-y-coords [35 28 21 14 7 0 -7 -14 -21 -28 -35 -42] 
  
  ;; --- defining road status ---
  foreach ave-x-ranges [ r ->
    ask patches with [pxcor >= first r and pxcor <= last r] [ set is-road? true set pcolor black ]
  ]
  foreach street-y-coords [ y ->
    ask patches with [pycor = y] [ set is-road? true set pcolor black ]
  ]
    set roads patches with [is-road?]
  
  ;; --- defining road intersections ---
  ;; this variable will be used later to make sure
  ;; no passengers and passenger destinations on the intersections
  foreach street-y-coords [ y ->
    foreach ave-x-ranges [ r ->
      ask patches with [pxcor >= first r and pxcor <= last r and pycor = y] [ set is-intersection? true ]
    ]
  ]
  set intersections patches with [is-intersection?]

  ;; --- adding Manhattan Oneway road logic ---
  ;; based on the real world moving logic
  ask patches with [is-road?] [
    set can-go-north? (pxcor = -60 or pxcor = -59 or pxcor = -20 or pxcor = -19 or pxcor = 20 or pxcor = 21 or pxcor = 49 or pxcor = 50)
    set can-go-south? (pxcor = -40 or pxcor = -39 or pxcor = 0 or pxcor = 1 or pxcor = 40 or pxcor = 41 or pxcor = 59 or pxcor = 60)
    let east-y [35 21 7 -7 -21 -35]
    let west-y [28 14 0 -14 -28 -42]
    ;; setting directions
    set can-go-east? member? pycor east-y 
    set can-go-west? member? pycor west-y
    ;; setting boundaries (with a not wrap map)
    if pycor >= 35 [ set can-go-north? false ] if pycor <= -42 [ set can-go-south? false ]
    if pxcor <= -60 [ set can-go-west? false ] if pxcor >= 60 [ set can-go-east? false ]
  ]
  
  ;; --- drawing road dividers (for aesthetic purposes only) ---
  ;; drawing vertical avenue dividers
  foreach (reduce sentence ave-x-ranges) [ x ->
    create-turtles 1 [
      setxy x -42 hide-turtle 
      set color white 
      set heading 0
      pen-down repeat 77 [ pen-up forward 0.5 pen-down forward 0.5 ] die
    ]
  ]
  ;; drawing horizontal street dividers
  foreach street-y-coords [ y ->
    create-turtles 1 [
      setxy -60 y hide-turtle 
      set color white 
      set heading 90
      pen-down repeat 120 [ pen-up forward 0.5 pen-down forward 0.5 ] die
    ]
  ]
  
end

to setup-signals
  ask intersections [
    ask neighbors4 with [not is-intersection? and is-road?] [ set is-signal-here? true ]
  ]
  set signal-posts patches with [is-signal-here?]
  let street-y [35 28 21 14 7 0 -7 -14 -21 -28 -35 -42]
  set row-signals signal-posts with [member? pycor street-y]
  set col-signals signal-posts with [not member? pycor street-y]
end

;; --- Setting demand zone for generating passengers and cruising viscosity ---
;; Demand zones are calibrated from TLC Trip Record Data (Jan 2025),
;; filtered to evening rush hour (17:00–18:00) yellow taxi pickups.
;; Pickup density per zone is projected to three demand-intensity tiers:
;;   1.0 (High) — 6th Ave to Park Ave corridor (highest pickup density)
;;   0.5 (Mid)  — 8th Ave to 6th Ave midtown core
;;   0.2 (Low)  — peripheral avenues (10th–9th Ave)
;; These values drive two mechanisms:
;;   1. Stochastic passenger spawning rate in generate-demand
;;   2. Taxi cruising viscosity (slower speed in denser zones) in taxi-speed-report
to setup-demand-zones
  ;; --- Non-road patches: background colour only (no demand logic) ---
  ;; Three-tier shading echoes the demand gradient for visual consistency
  ask patches with [not is-road?] [
    set demand-intensity 0
    set pcolor [255 245 220]          ; base cream — low-demand periphery
  ]
  ask patches with [not is-road? and pxcor >= -18 and pxcor <= 58 and pycor >= -20 and pycor < 35] [
    set pcolor [255 230 190]          ; warm sand — mid-demand area
  ]
  ask patches with [not is-road? and pxcor >= 22 and pxcor <= 58 and pycor >= -20 and pycor <= 34] [
    set pcolor [255 210 160]          ; amber — high-demand area
  ]

  ;; --- Road patches: assign demand-intensity values ---
  ask roads [
    set demand-intensity 0.2
    if pxcor >= -20 and pxcor <= 19 and pycor >= -21 and pycor <= 35 [ set demand-intensity 0.5 ]
    if pxcor >= 20 and pxcor <= 60 and pycor >= -21 and pycor <= 35 [ set demand-intensity 1.0 ]
  ]
end

to setup-population
  create-vehicles num-cars [
    set size 1
    
    ;; initial start-up delay 
    ;; !!! which is different from the dynamic delay used during congestion recovery !!!
    set reaction-delay 2 
    
    set has-passenger? false
    set blocked-by-signal? false
    
    ;; --- dividing the vehicle type: --- 
    ;; "backgrounnd"; "taxi"; "FHV"
    ifelse random-float 1.0 < commercial-vehicle-ratio [
      ifelse random-float 1.0 < Taxi-vs-FHV-split [ set vehicle-type "taxi" set color yellow ]
      [ set vehicle-type "FHV" set color cyan ]
    ] [ set vehicle-type "background traffic" set color blue ]
    move-to one-of roads with [not any? vehicles-here]
    
    ;; based on the road direction feature, setuping initial heading
    set-initial-heading
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; 2. RUNTIME PROCEDURES
;;;;;;;;;;;;;;;;;;;;;;;;;;

to go
  manage-signals
  generate-demand
  
  ;; checking if there is passenger every tick first
  ask vehicles [
    check-for-pickup
    check-for-arrival
    execute-motion-logic
  ]
  
  update-average-stats 
  
  update-baseline-speed
  
  tick
end

to manage-signals
  if ticks mod length-of-green-light = 0 [ set row-green? not row-green? set col-green? not col-green? ]
  
  ;; --- updating traffic light visuals ---
  ask row-signals [ set is-green? row-green? set pcolor ifelse-value is-green? [ green ] [ red ] ]
  ask col-signals [ set is-green? col-green? set pcolor ifelse-value is-green? [ green ] [ red ] ]
end

to generate-demand  
  ;; giving a suitable possibility to
  ;; generate pickup demand
  let base-spawn-rate 0.05
  
  ;; the slider "max-passenger" controls
  ;; how many pickup-demands one second 
  ;; the model can generate
  if count passengers >= max-passengers [ stop ]
  
  ;; ---- !!! only roads which are not intersections can generate passengers !!! ---
  ask roads with [not is-intersection?] [
    if random-float 1.0 < (base-spawn-rate * demand-intensity) [    
      sprout-passengers 1 [ 
        set shape "person" 
        set color white 
        set size 1 
        set destination-patch one-of roads with [
          ;; !!! the destination can not either be intersections !!!
          not is-intersection? and self != myself] 
      ]
    ]
  ]
end

to check-for-pickup
  if vehicle-type != "background traffic" and not has-passenger? [
    if any? passengers-here [
      let p one-of passengers-here      
      set target-patch [destination-patch] of p
      ;; --- giving both taxis and FHVs with passengers color red ---
      ;; (with color red they sharing the same moving logic) 
      set has-passenger? true set color red
      ;; --- adding trips counts ---
      ;; for caculating avg deadmile later
      if vehicle-type = "taxi" [ set taxi-trips taxi-trips + 1 ]
      if vehicle-type = "FHV" [ set FHV-trips FHV-trips + 1 ]
      ask p [ die ]
    ]
  ]
end

to check-for-arrival
  if has-passenger? and patch-here = target-patch [
    
    ;; recovering the road color after dropping off the passenger
    ask patch-here [if is-road?  [ set pcolor black ]]

    set has-passenger? false 
    set target-patch nobody
    
    ;; recovering the color of taxis and FHVs with no passenger
    ;; (!!! with different colors, their crusing logic is different !!!)
    set color ifelse-value (vehicle-type = "taxi") [ yellow ] [ cyan ]
  ]
end

;; --- Main per-tick movement procedure for each vehicle ---
;; Flow: reset state → safety checks → assign speed & heading by vehicle type
;;       → probabilistic speed filter → signal/congestion physics → move or wait
;;
;; Speed is modelled as a per-tick movement probability (move-prob):
;;   1.0 = always move ≈ 36.6 km/h (close to Midtown's 40 km/h limit)
;;   Lower values = fewer moves per tick = slower effective speed
;; This lets different vehicle types cruise at different speeds
;; without changing the discrete 1-patch-per-move grid mechanics
to execute-motion-logic  
  ;; --- Moving State Reset ---
  set is-congested? false 
  set blocked-by-signal? false 
  set did-move? false
  
  ;; --- location initialization (on the road) ---
  if not [is-road?] of patch-here [ move-to one-of roads with [not any? vehicles-here] set-initial-heading stop ]
  ;; making reaction delay work
  if reaction-delay > 0 [ set reaction-delay reaction-delay - 1 stop ]

  ;; --- Initializing Speed and Direction ---
  ;; !!! here i use moving probability every tick to control speed !!!  
  ;; background vehicles or vehicles when delivering will use this fastest speed (highest move-prob)!
  ;; and the highest speed of 1 is abt 36.6 km/h in real world, very close to Manhattan Midtown 40 km/h speed limit
  let move-prob 1.0 
  let chosen-h heading
  
  ;; --- !!! core mechanism !!!: filtering vehicle type and pickup status ---
  ;; then assigning driving status
  ifelse has-passenger? [ set chosen-h decide-delivery-heading-report ]
  [
    if vehicle-type = "taxi" [ set move-prob taxi-speed-report 
      set chosen-h taxi-direction-report ]
    if vehicle-type = "FHV" [ set move-prob FHV-speed-report 
      set chosen-h FHV-direction-report ]
    if vehicle-type = "background traffic" [ set chosen-h background-traffic-direction-report ]
  ]

  ;; --- Probabilistic Speed Filter ---  
  if random-float 1.0 > move-prob [ stop ]

  ;; --- !!! Physics Check !!! ---
  ;; checking traffic signals at intersections and vehicle blocking ahead
  let ahead patch-at-heading-and-distance chosen-h 1
  if ahead != nobody [
    if [is-intersection?] of ahead [
      if (chosen-h = 90 or chosen-h = 270) and not row-green? [ set blocked-by-signal? true ]
      if (chosen-h = 0 or chosen-h = 180) and not col-green? [ set blocked-by-signal? true ]
    ]
    if any? vehicles-on ahead [ set is-congested? true ]
  ]

  ;; --- Movement Execution ---
  ifelse ahead != nobody and not blocked-by-signal? and not is-congested? [
    set heading chosen-h forward 1 set did-move? true
    ;; Dead miles: only counting taxis and FHVs without passengers
    ;; background vehcile deadmile not counted
    if not has-passenger? and vehicle-type != "background traffic" [
      if vehicle-type = "taxi" [ set taxi-dead-miles taxi-dead-miles + 1 ]
      if vehicle-type = "FHV" [ set FHV-dead-miles FHV-dead-miles + 1 ]
    ]
  ] [
    ;; --- adding reaction and start-up delay ---
    ;; human reaction decay is abt 0.5-1s
    ;; with 1-1.5s start-up delay
    if reaction-delay = 0 [ set reaction-delay (1 + random 2) ]
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; 3. STRATEGIES
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; --- giving road direction based on the one way direction feature ---
to-report get-available-headings
  let avail []
  if can-go-north? [ set avail lput 0 avail ]
  if can-go-south? [ set avail lput 180 avail ]
  if can-go-west? [ set avail lput 270 avail ]
  if can-go-east? [ set avail lput 90 avail ]
  report avail
end

;; --- setup initial direction ----
to set-initial-heading
  let avail get-available-headings
  if not empty? avail [ set heading one-of avail ]
end

;; --- Background traffic follows random routing behaviour ---
;; chooses a random available heading constrained by road directionality
to-report background-traffic-direction-report
  let avail get-available-headings
  report ifelse-value (not empty? avail) [ one-of avail ] [ heading ]
end

;; --- !!! taxi viscous cruising speed behaviour: !!! ---
;; taxis move slower in higher demand zones (more stopping and slower speed)
;; the speed was set based on the demand-density heatmap which was calibrated by TLC pickup data (Jan 2025)
;; so here i can model a relative real-world visco for taxis cruising
;; at highest demand zone, with a speed of 0.4 (abt 14.4 km/h in real world)
;; at medium demand zone, with a speed of 0.6 (abt 21.6 km/h in real world)
;; at low demand zone, with a speed of 0.8 (abt 28.8 km/h in real world)
to-report taxi-speed-report
  let d [demand-intensity] of patch-here
  report ifelse-value (d >= 1.0) [ 0.4 ] [ ifelse-value (d >= 0.5) [ 0.6 ] [ 0.8 ] ]
end

;; --- !!! taxi viscous cruising direction choosing behaviour: !!! ---
;; taxis trying to head higher demand zones
;; based on drivers pick-up experience
to-report taxi-direction-report
  ;; filtering the directions can be choosed first
  let avail get-available-headings
  ;; if no directions available, keeping moving
  if empty? avail [ report heading ]

  ;; --- taxis turning logic when at intersections---
  let best-h nobody
  let best-d 0
  foreach avail [ h ->
    ;; temporary variables for caculating total demand density in each direction
    let total-d 0
    let dist 1
    
    ;; here i gave a vision of 10 patches (100m in real world)
    while [dist <= 10] [
      let target-patch-taxi patch-at-heading-and-distance h dist
      if target-patch-taxi != nobody and [is-road?] of target-patch-taxi [
        set total-d total-d + [demand-intensity] of target-patch-taxi
      ]
      set dist dist + 1
    ]
    ;; best-h (best-heading) will be the one with highest total demand density in 10 patches
    if total-d > best-d [ set best-d total-d set best-h h ]
  ]
  
  ;; taxis have a possibility of 0.8 for choosing the best-h (best-heading) 
  ifelse best-h != nobody and random-float 1.0 < 0.8
    [ report best-h ]
    [ report one-of avail ]
end

;; --- !!! FHV viscous cruising speed behaviour: !!! ---
;; in real world, FHVs will choosing parking or relatively slower speed when cruising
;; however there will be expensive or no room for parking to wait passengers in Manhattan midtown
;; so in this model FHVs will only cruising at speed 0f 0.8 (abt 28.8km/h in real world)
;; (a little bit slower than background vehicles and delivering passengers speed (speed of 1))
to-report FHV-speed-report
  report 0.8
end

;; --- !!! FHVs viscous cruising direction choosing behaviour: !!! ---
;; FHVs have platform-assigned orders, 
;; they do not need to adopt a behavior pattern of flooding into high-demand areas
;; so they will just choose directions based on the oneway road system, waiting for the platform to assign an order

;; It is worth noting that this model does not include a platform dispatch mechanism for FHVs, 
;; because this mechanism has been proven to easily cause an imbalance in the competition between FHVs and taxis.

to-report FHV-direction-report
  let avail get-available-headings
  report ifelse-value (not empty? avail) [ one-of avail ] [ heading ]
end

;; --- greedy grid navigation algorithm for delivering passengers ---
;; While adhering to traffic rules, prioritize directions that shorten the distance to the target
;; if that's not possible, randomly select a legal direction.
to-report decide-delivery-heading-report
  let potential get-available-headings
  if empty? potential [ report heading ]
  let tx [pxcor] of target-patch 
  let ty [pycor] of target-patch
  let best []
  if (tx > pxcor) and (member? 90 potential) [ set best lput 90 best ]
  if (tx < pxcor) and (member? 270 potential) [ set best lput 270 best ]
  if (ty > pycor) and (member? 0 potential) [ set best lput 0 best ]
  if (ty < pycor) and (member? 180 potential) [ set best lput 180 best ]
  report ifelse-value (not empty? best) [ one-of best ] [ one-of potential ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; 4. METRICS 
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to update-average-stats
  ;; deadmile metrics: per trip deadmile  
  ifelse taxi-trips > 0
    [ set avg-taxi-dead-per-trip (taxi-dead-miles / taxi-trips) ]
    [ set avg-taxi-dead-per-trip 0 ]
  ifelse FHV-trips > 0
    [ set avg-FHV-dead-per-trip (FHV-dead-miles / FHV-trips) ]
    [ set avg-FHV-dead-per-trip 0 ]
  
  ;; congestion metrics: global-average-speed
  if not any? vehicles [
    set global-average-speed 0
    stop
  ]
  set global-average-speed (count vehicles with [did-move?] / count vehicles)
end

;; --- adding baseline speed ---
;; here i used BehaivorSpeed to loop the Avg Speed with all num-cars parameters 
;; and keep all vehciles background type and traffic light interval is locked at 5  

;; with this, now can easily comparing the negative influence of taxis and FHVs cruising

to update-baseline-speed
  if num-cars = 200 [ set baseline-speed-value 0.70 ]
  if num-cars = 300 [ set baseline-speed-value 0.60 ]
  if num-cars = 400 [ set baseline-speed-value 0.51 ]
  if num-cars = 500 [ set baseline-speed-value 0.46 ]
  if num-cars = 600 [ set baseline-speed-value 0.42 ]
  if num-cars = 700 [ set baseline-speed-value 0.39 ]
  if num-cars = 800 [ set baseline-speed-value 0.36 ]
  if num-cars = 900 [ set baseline-speed-value 0.34 ]
  if num-cars = 1000 [ set baseline-speed-value 0.31 ]
  if num-cars = 1100 [ set baseline-speed-value 0.29 ]
  if num-cars = 1200 [ set baseline-speed-value 0.26 ]
  if num-cars = 1300 [ set baseline-speed-value 0.24 ]
  if num-cars = 1400 [ set baseline-speed-value 0.22 ]
  if num-cars = 1500 [ set baseline-speed-value 0.20 ]
end


















]]></code>
  <widgets>
    <view x="300" wrappingAllowedX="false" y="20" frameRate="30.0" minPycor="-42" height="529" showTickCounter="true" patchSize="6.74" fontSize="10" wrappingAllowedY="false" width="819" tickCounterLabel="ticks" maxPycor="35" updateMode="0" maxPxcor="60" minPxcor="-60"></view>
    <slider x="40" step="100" y="20" max="1500" width="250" display="num-cars" height="50" min="200" direction="Horizontal" default="1000.0" variable="num-cars"></slider>
    <plot x="1130" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Speed (m/s)" y="335" xMin="0.0" height="215" legend="true" xMax="10.0" yMin="0.0" width="280" xAxis="Time (s)" display="Global Avg Speed">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Global Avg Speed" color="-16777216" legend="true">
        <setup></setup>
        <update><![CDATA[if ticks > 5 [ plot global-average-speed * 10 ]]]></update>
      </pen>
      <pen interval="1.0" mode="0" display="Baseline" color="-2674135" legend="true">
        <setup></setup>
        <update><![CDATA[if ticks > 5 [ plot baseline-speed-value * 10 ]]]></update>
      </pen>
    </plot>
    <plot x="1415" autoPlotX="true" yMax="2.0" autoPlotY="true" y="335" xMin="0.0" height="215" legend="true" xMax="10.0" yMin="0.0" width="275" xAxis="Time (ticks)" display="Speed Ratio (vs Baseline)">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Ratio" color="-16777216" legend="true">
        <setup></setup>
        <update><![CDATA[if ticks > 5 [ plot global-average-speed / baseline-speed-value ]]]></update>
      </pen>
      <pen interval="1.0" mode="0" display="No Impact ( =1)" color="-2674135" legend="true">
        <setup></setup>
        <update>plot 1</update>
      </pen>
    </plot>
    <monitor x="1130" precision="17" y="265" height="60" fontSize="11" width="185" display="Vacant Taxi Hotspot Ratio"><![CDATA[(count vehicles with [vehicle-type = "taxi" and not has-passenger? and [demand-intensity] of patch-here >= 1.0]) 
/ 
(count vehicles with [vehicle-type = "taxi" and not has-passenger?] + 0.0001)]]></monitor>
    <monitor x="1320" precision="17" y="265" height="60" fontSize="11" width="185" display="Vacant FHV Hotspot Radio"><![CDATA[(count vehicles with [vehicle-type = "FHV" and not has-passenger? and [demand-intensity] of patch-here >= 1.0]) 
/ 
(count vehicles with [vehicle-type = "FHV" and not has-passenger?] + 0.0001)]]></monitor>
    <monitor x="1510" precision="17" y="265" height="60" fontSize="11" width="180" display="Avg Cruising Distance (m)">10 * (taxi-dead-miles + FHV-dead-miles) /  (taxi-trips + FHV-trips + 0.00001)</monitor>
    <plot x="1130" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Distance (m)" y="20" xMin="0.0" height="235" legend="true" xMax="10.0" yMin="0.0" width="280" xAxis="Time (s)" display="Total Service Dead Distance">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Total" color="-16777216" legend="true">
        <setup></setup>
        <update>plot (taxi-dead-miles + FHV-dead-miles) * 10</update>
      </pen>
      <pen interval="1.0" mode="0" display="Taxi" color="-1184463" legend="true">
        <setup></setup>
        <update>plot taxi-dead-miles * 10</update>
      </pen>
      <pen interval="1.0" mode="0" display="FHV" color="-13791810" legend="true">
        <setup></setup>
        <update>plot FHV-dead-miles * 10</update>
      </pen>
    </plot>
    <plot x="1415" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Distance (m)" y="20" xMin="0.0" height="235" legend="true" xMax="10.0" yMin="0.0" width="275" xAxis="Time (s)" display="Average Dead Distance">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Avg Taxi" color="-1184463" legend="true">
        <setup></setup>
        <update>plot avg-taxi-dead-per-trip * 10</update>
      </pen>
      <pen interval="1.0" mode="0" display="Avg FHV" color="-11221820" legend="true">
        <setup></setup>
        <update>plot avg-FHV-dead-per-trip * 10</update>
      </pen>
    </plot>
