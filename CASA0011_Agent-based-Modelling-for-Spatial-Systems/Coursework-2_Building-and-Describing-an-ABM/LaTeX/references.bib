@article{millard-ball2023,
  title        = {Where Ridehail Drivers Go between Trips},
  author       = {Millard-Ball, Adam and Liu, Liwei and Hansen, Whitney and Cooper, Drew and Castiglione, Joe},
  date         = {2023-10-01},
  journaltitle = {Transportation},
  shortjournal = {Transportation},
  volume       = {50},
  number       = {5},
  pages        = {1959--1981},
  issn         = {1572-9435},
  doi          = {10.1007/s11116-022-10298-5},
  url          = {https://doi.org/10.1007/s11116-022-10298-5},
  urldate      = {2026-04-11},
  abstract     = {We analyze what ridehail drivers do when searching for paid fares. We use a dataset of 5.3 million trips in San Francisco and partition each search trip into cruising, repositioning, and parking segments. We find that repositioning accounts for nearly two-thirds (63\%) of the time between trips, with cruising and parking accounting for 23\% and 14\% respectively (these figures exclude short trips). Our regression models suggest that drivers tend to make reasonable choices between repositioning and parking, heading to high-demand locations based on the time of day. However, we also find evidence of racial disparities, supporting previous studies of both taxis and ridehailing that indicate that drivers tend to avoid neighborhoods with high proportions of residents of color.},
  langid       = {english},
  keywords     = {Cruising,Curb management,Parking,Ridehailing,Transportation network companies},
  file         = {C:\Users\17902\Zotero\storage\PWED7PT5\Millard-Ball et al. - 2023 - Where ridehail drivers go between trips.pdf}
}

