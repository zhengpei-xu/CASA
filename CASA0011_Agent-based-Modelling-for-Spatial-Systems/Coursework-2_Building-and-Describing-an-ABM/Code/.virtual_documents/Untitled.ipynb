import pandas as pd

# Define the file path
file_path = "../Data/yellow_tripdata_2025-01.parquet"

# Read the parquet file
df = pd.read_parquet(file_path)

# Display basic info and the first few rows
print(df.info())
print(df.head())

# Filter for peak hours (e.g., Evening Rush 17:00-19:00)
df['tpep_pickup_datetime'] = pd.to_datetime(df['tpep_pickup_datetime'])
rush_hour_data = df[df['tpep_pickup_datetime'].dt.hour.isin([17, 18])]

# Calculate total pickups for your target zones
# Replace [161, 162] with your specific Manhattan LocationIDs
target_zones = [161, 162, 230]
peak_demand = rush_hour_data[rush_hour_data['PULocationID'].isin(target_zones)]

print(f"Total pickups during rush hour in target zones: {len(peak_demand)}")



