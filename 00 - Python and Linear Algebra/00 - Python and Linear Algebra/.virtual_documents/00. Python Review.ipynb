class City:
    def __init__(self, name, pop, area):
        self.name = name
        self.population = pop
        self.area = area
        self. density = pop/area
    def info(self):
        print(f'name: {self.name}, population: {self.population}, area: {self.area}, density {self.density}')


london = City('London', 8961989, 1572)


london.info()





